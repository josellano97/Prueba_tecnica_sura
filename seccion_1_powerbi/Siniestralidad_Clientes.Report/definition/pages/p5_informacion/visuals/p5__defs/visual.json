              },
              {
                "textRuns": [
                  {
                    "value": "Fuente y actualización",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#0055A0",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Tablas clientes, casos, facturación y prevención (datos sintéticos generados por datos/generar_datos.py). Actualización diaria; los datos llegan con corte al día anterior.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#16212E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
