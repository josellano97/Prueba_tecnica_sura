# Copie este archivo como .env para desarrollo local (el .env NUNCA se sube al repositorio).
# En Azure estas variables se configuran como "App Settings" del App Service (o referencias a Key Vault).

# --- Django ---
# Desarrollo: config.settings.dev  |  Producción: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Obligatoria en producción (mínimo 50 caracteres). Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Dominios permitidos, separados por coma (en Azure: <su-app>.azurewebsites.net)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes para CSRF (opcional; en producción se derivan de ALLOWED_HOSTS con https://)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- Base de datos ---
# Vacío = SQLite local (db.sqlite3). Ejemplos:
#   SQLite persistente en App Service: sqlite:////home/data/db.sqlite3
#   PostgreSQL en Azure:              postgres://usuario:clave@servidor.postgres.database.azure.com:5432/monitoreo?sslmode=require
DATABASE_URL=

# --- Sesión (segundos de inactividad antes de pedir login de nuevo; 8 h por defecto) ---
SESSION_COOKIE_AGE=28800

# --- Solo para cargar usuarios de demostración (opcional) ---
# Si se omite, cargar_datos_demo --usuarios-demo genera contraseñas aleatorias y las muestra una vez.
DEMO_PASSWORD=
