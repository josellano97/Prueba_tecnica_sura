        "authentication": "basicAuth",
        "initialMessages": "Hola 👋 Soy el asistente de siniestralidad.\nPregúntame, por ejemplo: ¿cuántos casos tuvo Nogal Minería este mes? o ¿qué clientes están críticos?",
        "options": {
          "title": "Asistente de siniestralidad",
          "subtitle": "Datos del tablero de monitoreo",
          "inputPlaceholder": "Escribe tu pregunta…",
          "loadPreviousSession": "memory"
        }
      },
